diff --git a/src/layout/tests/align_right.rs b/src/layout/tests/align_right.rs
new file mode 100644
index 00000000..36f9ed6b
--- /dev/null
+++ b/src/layout/tests/align_right.rs
@@ -0,0 +1,168 @@
+use std::fmt::Write as _;
+
+use super::*;
+
+fn make_options() -> Options {
+    Options {
+        layout: niri_config::Layout {
+            gaps: 0.0,
+            align_columns_right: true,
+            default_column_width: Some(PresetSize::Proportion(0.25)),
+            ..Default::default()
+        },
+        ..Options::default()
+    }
+}
+
+/// Final (animations completed) X of every tile on the active workspace, by window id.
+fn tile_xs(layout: &mut Layout<TestWindow>) -> String {
+    check_ops_on_layout(layout, [Op::CompleteAnimations]);
+    let mut buf = String::new();
+    let ws = layout.active_workspace().unwrap();
+    let mut tiles: Vec<_> = ws
+        .tiles_with_render_positions()
+        .map(|(tile, pos, _)| (*tile.window().id(), pos.x, tile.tile_size().w))
+        .collect();
+    tiles.sort_by_key(|(id, _, _)| *id);
+    for (id, x, w) in tiles {
+        writeln!(&mut buf, "{id}: x={x:.0} w={w:.0}").unwrap();
+    }
+    buf
+}
+
+fn add(id: usize) -> Op {
+    Op::AddWindow {
+        params: TestWindowParams::new(id),
+    }
+}
+
+#[test]
+fn new_columns_open_on_the_left_and_stay_right_aligned() {
+    let mut layout = check_ops_with_options(make_options(), [Op::AddOutput(1), add(1)]);
+    assert_eq!(tile_xs(&mut layout), "1: x=1180 w=100\n");
+
+    check_ops_on_layout(&mut layout, [add(2), add(3)]);
+    assert_eq!(
+        tile_xs(&mut layout),
+        "1: x=1180 w=100\n2: x=1080 w=100\n3: x=980 w=100\n"
+    );
+
+    // Focusing another output and back doesn't move anything.
+    check_ops_on_layout(
+        &mut layout,
+        [Op::AddOutput(2), Op::FocusOutput(2), Op::FocusOutput(1)],
+    );
+    assert_eq!(
+        tile_xs(&mut layout),
+        "1: x=1180 w=100\n2: x=1080 w=100\n3: x=980 w=100\n"
+    );
+
+    check_ops_on_layout(&mut layout, [Op::CloseWindow(3)]);
+    assert_eq!(tile_xs(&mut layout), "1: x=1180 w=100\n2: x=1080 w=100\n");
+}
+
+#[test]
+fn inactive_column_resize_keeps_right_alignment() {
+    let mut layout =
+        check_ops_with_options(make_options(), [Op::AddOutput(1), add(1), add(2), add(3)]);
+    check_ops_on_layout(
+        &mut layout,
+        [
+            Op::SetForcedSize {
+                id: 1,
+                size: Some(Size::new(200, 100)),
+            },
+            Op::Communicate(1),
+        ],
+    );
+    assert_eq!(
+        tile_xs(&mut layout),
+        "1: x=1080 w=200\n2: x=980 w=100\n3: x=880 w=100\n"
+    );
+}
+
+#[test]
+fn column_moved_from_other_output_opens_on_the_left() {
+    let mut layout = check_ops_with_options(
+        make_options(),
+        [
+            Op::AddOutput(1),
+            add(1),
+            Op::AddOutput(2),
+            Op::FocusOutput(2),
+            add(2),
+        ],
+    );
+    check_ops_on_layout(
+        &mut layout,
+        [Op::MoveColumnToOutput {
+            output_id: 1,
+            target_ws_idx: None,
+            activate: true,
+        }],
+    );
+    assert_eq!(tile_xs(&mut layout), "1: x=1180 w=100\n2: x=1080 w=100\n");
+}
+
+#[test]
+fn resize_after_moving_from_wider_output_is_anchored_on_the_right() {
+    let mut options = Options::default();
+    options.layout.gaps = 0.;
+    let part = niri_config::LayoutPart {
+        align_columns_right: Some(Flag(true)),
+        ..Default::default()
+    };
+    let mut layout = check_ops_with_options(
+        options,
+        [
+            // 640 px wide logical output with right-aligned columns.
+            Op::AddScaledOutput {
+                id: 1,
+                scale: 2.,
+                layout_config: None,
+            },
+            Op::UpdateOutputLayoutConfig {
+                id: 1,
+                layout_config: Some(Box::new(part)),
+            },
+            add(1),
+            Op::SetColumnWidth(SizeChange::SetProportion(25.)),
+            Op::Communicate(1),
+            // 1280 px wide output.
+            Op::AddOutput(2),
+            Op::FocusOutput(2),
+            add(2),
+            Op::SetColumnWidth(SizeChange::SetProportion(25.)),
+            Op::Communicate(2),
+            Op::CompleteAnimations,
+            Op::MoveColumnToOutput {
+                output_id: 1,
+                target_ws_idx: None,
+                activate: true,
+            },
+        ],
+    );
+
+    for frame in 0..12 {
+        if frame == 2 {
+            // The client commits its new, smaller size a bit later.
+            check_ops_on_layout(&mut layout, [Op::Communicate(2)]);
+        }
+
+        let ws = layout.active_workspace().unwrap();
+        for (tile, pos, _) in ws.tiles_with_render_positions() {
+            let right = pos.x + tile.animated_tile_size().w;
+            match tile.window().id() {
+                // The window that was already there never moves.
+                1 => assert_eq!((pos.x, right), (480., 640.), "frame {frame}"),
+                // The moved window shrinks from its left edge.
+                2 => assert_eq!(right.round(), 480., "frame {frame}"),
+                _ => unreachable!(),
+            }
+        }
+
+        check_ops_on_layout(&mut layout, [Op::AdvanceAnimations { msec_delta: 25 }]);
+    }
+
+    assert_eq!(tile_xs(&mut layout), "1: x=480 w=160\n2: x=320 w=160\n");
+}
diff --git a/src/layout/tests/tweaks.rs b/src/layout/tests/tweaks.rs
new file mode 100644
index 00000000..4bfdba75
--- /dev/null
+++ b/src/layout/tests/tweaks.rs
@@ -0,0 +1,103 @@
+use super::*;
+
+fn add(id: usize) -> Op {
+    Op::AddWindow {
+        params: TestWindowParams::new(id),
+    }
+}
+
+fn options(f: impl FnOnce(&mut niri_config::Layout)) -> Options {
+    let mut options = Options::default();
+    options.layout.gaps = 0.;
+    f(&mut options.layout);
+    options
+}
+
+fn height_of(layout: &Layout<TestWindow>, id: usize) -> f64 {
+    let ws = layout.active_workspace().unwrap();
+    ws.tiles_with_render_positions()
+        .find(|(tile, _, _)| *tile.window().id() == id)
+        .map(|(tile, _, _)| tile.tile_size().h)
+        .unwrap()
+}
+
+fn x_of(layout: &mut Layout<TestWindow>, id: usize) -> f64 {
+    check_ops_on_layout(layout, [Op::CompleteAnimations]);
+    let ws = layout.active_workspace().unwrap();
+    ws.tiles_with_render_positions()
+        .find(|(tile, _, _)| *tile.window().id() == id)
+        .map(|(_, pos, _)| pos.x)
+        .unwrap()
+}
+
+/// Two stacked windows, window 1 with a fixed height, then window 2 closes.
+fn stacked_then_close(options: Options) -> Layout<TestWindow> {
+    check_ops_with_options(
+        options,
+        [
+            Op::AddOutput(1),
+            add(1),
+            add(2),
+            Op::ConsumeOrExpelWindowLeft { id: None },
+            Op::SetWindowHeight {
+                id: Some(1),
+                change: SizeChange::SetFixed(100),
+            },
+            Op::Communicate(1),
+            Op::Communicate(2),
+            Op::CloseWindow(2),
+            Op::Communicate(1),
+        ],
+    )
+}
+
+#[test]
+fn reset_height_when_alone_fills_column() {
+    let layout = stacked_then_close(options(|l| l.reset_height_when_alone = true));
+    assert_eq!(height_of(&layout, 1), 720.);
+}
+
+#[test]
+fn without_reset_height_when_alone_keeps_fixed_height() {
+    let layout = stacked_then_close(options(|_| ()));
+    assert_eq!(height_of(&layout, 1), 100.);
+}
+
+fn one_narrow_column(options: Options) -> Layout<TestWindow> {
+    check_ops_with_options(
+        options,
+        [
+            Op::AddOutput(1),
+            add(1),
+            Op::SetColumnWidth(SizeChange::SetProportion(25.)),
+            Op::Communicate(1),
+            Op::CompleteAnimations,
+        ],
+    )
+}
+
+#[test]
+fn toggle_center_column_goes_back() {
+    let mut layout = one_narrow_column(options(|l| l.toggle_center_column = true));
+    let start = x_of(&mut layout, 1);
+
+    check_ops_on_layout(&mut layout, [Op::CenterColumn]);
+    let centered = x_of(&mut layout, 1);
+    assert_eq!(centered, (1280. - 320.) / 2.);
+
+    check_ops_on_layout(&mut layout, [Op::CenterColumn]);
+    assert_eq!(x_of(&mut layout, 1), start);
+
+    // And a third press centers again.
+    check_ops_on_layout(&mut layout, [Op::CenterColumn]);
+    assert_eq!(x_of(&mut layout, 1), centered);
+}
+
+#[test]
+fn without_toggle_center_column_stays_centered() {
+    let mut layout = one_narrow_column(options(|_| ()));
+    check_ops_on_layout(&mut layout, [Op::CenterColumn]);
+    let centered = x_of(&mut layout, 1);
+    check_ops_on_layout(&mut layout, [Op::CenterColumn]);
+    assert_eq!(x_of(&mut layout, 1), centered);
+}
